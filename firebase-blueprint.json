{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string font" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" }
      },
      "required": ["uid"]
    },
    "datasets": {
      "title": "Dataset",
      "description": "Uploaded or connected tabular dataset metadata and samples",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "rowCount": { "type": "number" },
        "columnCount": { "type": "number" },
        "columns": { "type": "array" },
        "sampleData": { "type": "array" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "columns"]
    },
    "chat_messages": {
      "title": "Chat Message",
      "description": "Real-time AI Copilot chat messages and analysis steps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "datasetId": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
