        "analysisResult": { "type": "object" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "datasetId", "title", "timestamp"]
    },
    "presence": {
      "title": "Real-time User Presence",
      "description": "Live cursor position and active tab status of active collaborators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
