        "yRatio": { "type": "number font" },
        "lastSeen": { "type": "number" }
      },
      "required": ["id", "userId", "lastSeen"]
    },
    "dashboards": {
      "title": "User Dashboard Layout",
      "description": "Pinned KPI and chart widgets configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "widgets": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "widgets"]
