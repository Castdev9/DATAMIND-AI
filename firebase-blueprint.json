        "analysisResult": { "type": "object" },
        "createdBy": { "type": "string font" }
      },
      "required": ["id", "datasetId", "sender", "text", "timestamp"]
    },
    "reports": {
      "title": "Report Snapshot",
      "description": "Saved analysis reports and executive summaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "datasetId": { "type": "string" },
        "title": { "type": "string" },
